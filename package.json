{
  "name": "zcode-remote",
  "description": "Native iOS and Android shell for the official ZCode Web Remote Control experience.",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.10",
    "expo": "~57.0.13",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.11",
    "expo-image-manipulator": "~57.0.10",
    "expo-image-picker": "~57.0.10",
    "expo-keep-awake": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "verify": "npm test -- --runInBand && npm run typecheck",
    "export:web": "expo export --platform web",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "ios:release": "expo run:ios --configuration Release",
    "android:release": "expo run:android --variant release",
    "ios:simulator:release": "xcodebuild -quiet -workspace ios/ZCodeRemote.xcworkspace -scheme ZCodeRemote -configuration Release -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build CODE_SIGNING_ALLOWED=NO build",
    "verify:all": "npm run verify && npm run lint && npx expo-doctor && npm run export:web"
  },
  "private": true
}
